# Secrets and Credentials (Never let AI see these)
credentials/
.env*
google-services.json
auth_log.txt
*.keystore
*.jks
*.pem

# Noise and Dependencies (Saves context window/tokens)
node_modules/
.expo/
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.android_sdk/
.maestro/
.browser-test/
tmp/
**/tmp/

# Binary Assets (Useless for text-based LLMs)
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.ico
*.avif
*.pdf
*.zip
*.tar*
*.gz
*.apk
*.aab
*.jar
*.so
*.a
