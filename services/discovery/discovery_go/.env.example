# Tavern Swiper — Discovery Service (Go)
SERVICE_NAME=discovery
SERVICE_PORT=8003
LOG_LEVEL=info

# Infrastructure
FIRESTORE_DATABASE_ID=discovery-dev
PROFILES_CACHE_DATABASE_ID=discovery-dev

# Pub/Sub
PUBSUB_PROJECT_ID=tavern-swiper-dev
PUBSUB_TOPIC_ID=dev-discovery-match-events-v1

# JWT — Must match all other services
JWT_SECRET=<shared-jwt-secret-must-match-all-services>
GOOGLE_CLOUD_PROJECT=tavern-swiper-dev
GOOGLE_APPLICATION_CREDENTIALS=${HOME}/.config/gcloud/application_default_credentials.json
PORT=8003
