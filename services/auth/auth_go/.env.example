# Tavern Swiper — Auth Service (Go)
SERVICE_NAME=auth
SERVICE_PORT=8001
LOG_LEVEL=info

# Infrastructure
USERS_DATABASE_ID=users-dev

# Firebase Config
FIREBASE_WEB_API_KEY=<your-firebase-web-api-key>
GOOGLE_APPLICATION_CREDENTIALS=${HOME}/.config/gcloud/application_default_credentials.json
JWT_SECRET=<shared-jwt-secret-must-match-all-services>
GOOGLE_CLOUD_PROJECT=tavern-swiper-dev
