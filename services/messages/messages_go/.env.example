# Tavern Swiper — Messages Service (Go)
SERVICE_NAME=messages
SERVICE_PORT=8005
LOG_LEVEL=info

# Infrastructure
FIRESTORE_DATABASE_ID=messages-dev

# JWT — Must match all other services
JWT_SECRET=<shared-jwt-secret-must-match-all-services>

# Service Discovery — Router resolves all other service URLs at runtime
ROUTER_SERVICE_URL=http://router:8010
ROUTER_TAG=default
GOOGLE_APPLICATION_CREDENTIALS=${HOME}/.config/gcloud/application_default_credentials.json
