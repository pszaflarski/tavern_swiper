# EAS Build ignore file
# When this file exists, EAS uses it INSTEAD of .gitignore for archiving.
# We deliberately do NOT ignore .env so EXPO_PUBLIC_* vars are available during builds.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (regenerated by prebuild)
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
/ios
/android

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (but NOT .env itself!)
.env*.local

# typescript
*.tsbuildinfo

# test outputs
*.txt
*.log
